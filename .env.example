# Copy to .env and fill in real values. Never commit .env.

# --- App (read directly by app/config.py:Settings) ---

# postgresql://user:password@host:5432/dbname
# Only used for local `uvicorn --reload` dev. Under docker-compose, the api
# service builds this from the POSTGRES_* vars below instead (see docker-compose.yml).
DATABASE_URL=postgresql://fitlink:fitlink@localhost:5432/fitlink

# openssl rand -hex 32
SECRET_KEY=changeme

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- docker-compose only (postgres + cloudflared services) ---

POSTGRES_USER=fitlink
POSTGRES_PASSWORD=changeme
POSTGRES_DB=fitlink

# Token for the Cloudflare Tunnel connector. Create the tunnel in the Zero
# Trust dashboard and copy its token here — see docs/deploy.md.
CLOUDFLARE_TUNNEL_TOKEN=changeme
